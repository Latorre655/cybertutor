        "jsCode": "return [\n  { json: { url: 'https://www.incibe.es/incibe-cert/alerta-temprana/avisos/feed' } },\n  { json: { url: 'https://www.cisa.gov/cybersecurity-advisories/all.xml' } },\n  { json: { url: 'https://www.welivesecurity.com/en/rss/feed/' } },\n];"
