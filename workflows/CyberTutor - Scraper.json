      ],
      "id": "ea0c718b-fbb8-4b68-a0ba-86f12c25c31d",
      "name": "RSS Read",
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const mapa = {\n  'www.incibe.es': 'INCIBE-CERT',\n  'www.cisa.gov': 'CISA',\n  'www.welivesecurity.com': 'WeLiveSecurity (ESET)',\n};\n\nconst items = $input.all()\n  .map(i => i.json)\n  .filter(j => j.link && j.title)\n  .map(j => {\n    const f = new Date(j.isoDate || j.pubDate || '');\n    return { j, f, t: isNaN(f) ? 0 : f.getTime() };\n  })\n  .sort((a, b) => b.t - a.t);          // más recientes primero\n\nconst conteo = {};\nconst out = [];\nfor (const { j, f, t } of items) {\n  const m = String(j.link).match(/^https?:\\/\\/([^\\/]+)/);\n  const host = m ? m[1] : '';\n  const fuente = mapa[host] || host || 'desconocida';\n  conteo[fuente] = (conteo[fuente] || 0) + 1;\n  if (conteo[fuente] > 10) continue;     // máximo 10 por fuente\n  const resumen = String(j.contentSnippet || j.content || '')\n    .replace(/<[^>]+>/g, ' ').replace(/\\s+/g, ' ').trim().slice(0, 400);\n  out.push({ json: {\n    titulo: String(j.title).trim(),\n    fuente,\n    url: j.link,\n    fecha_publicacion: t ? f.toISOString() : null,\n    categoria: 'ciberseguridad',\n    resumen,\n  }});\n}\nreturn out;"
      },
